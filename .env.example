# Optional. The app works without this, but answers are better with an LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MLflow
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=research-paper-ragops

# Required for the public API. Use long, random, comma-separated values.
PAPERWISE_API_KEYS=
PAPERWISE_RATE_LIMIT=30
# Exact browser origins only, comma separated (no wildcard).
PAPERWISE_CORS_ORIGINS=
PAPERWISE_DOMAIN=paperwise.example.com
